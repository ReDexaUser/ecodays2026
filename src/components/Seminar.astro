---
import { Icon } from "astro-icon/components";
import { SEMINAR } from "../data/config";

const base = import.meta.env.BASE_URL;
const basePath = base === '/' ? '' : base.replace(/\/+$/, '');

const posterImages = import.meta.glob<string>("/src/assets/poster/*.{jpeg,jpg,png,webp,WEBP}", { eager: true, query: "?url", import: "default" });
const posterSrc = SEMINAR.poster ? posterImages[`/src/assets/poster/${SEMINAR.poster}`] : undefined;

const schedule = [
  { label: "Tanggal", value: SEMINAR.date, icon: "lucide:calendar" },
  { label: "Waktu", value: SEMINAR.time, icon: "lucide:clock" },
  { label: "Tempat", value: SEMINAR.venue, icon: "lucide:map-pin" },
];
---

<section id="seminar" class="py-20 bg-surface relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-primary text-center fade-in-up">
      {SEMINAR.title}
    </h2>

    <a
      href={basePath + "/seminar"}
      class="group relative mt-12 block glass rounded-3xl overflow-hidden ring-1 ring-white/10 hover:ring-accent/30 hover:-translate-y-1 hover:shadow-2xl hover:shadow-accent/10 transition-all duration-300 fade-in-up card-shadow"
      style="transition-delay: 100ms"
    >
      <div class="pointer-events-none absolute -top-24 -right-16 w-72 h-72 bg-accent/10 rounded-full blur-3xl opacity-60 group-hover:opacity-100 transition-opacity duration-500"></div>

      <div class="relative grid md:grid-cols-[300px_1fr]">
        <!-- poster -->
        <div class="relative flex items-center justify-center p-5 md:p-6 bg-white/[0.03] border-b md:border-b-0 md:border-r border-border">
          {posterSrc ? (
            <img
              src={posterSrc}
              alt={`Poster ${SEMINAR.title}`}
              class="w-full max-w-[240px] rounded-xl ring-1 ring-white/10 shadow-lg shadow-black/30 transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
          ) : (
            <div class="w-full max-w-[240px] aspect-[3/4] rounded-xl glass flex items-center justify-center text-muted text-sm">
              Poster belum tersedia
            </div>
          )}
        </div>

        <!-- info -->
        <div class="relative p-6 md:p-8">
          <span class="text-accent text-xs font-bold uppercase tracking-[0.2em]">{SEMINAR.shortName}</span>
          <p class="mt-2 text-xl md:text-2xl text-primary font-semibold leading-relaxed">{SEMINAR.theme}</p>

          <div class="mt-6 grid sm:grid-cols-3 gap-3">
            {schedule.map((s) => (
              <div class="rounded-2xl bg-white/5 border border-border p-4 flex items-start gap-3">
                <span class="w-9 h-9 rounded-lg bg-accent/15 flex items-center justify-center shrink-0">
                  <Icon name={s.icon} class="w-4 h-4 text-accent" />
                </span>
                <div>
                  <p class="text-xs text-muted uppercase tracking-wider font-bold">{s.label}</p>
                  <p class="text-primary font-semibold mt-0.5 leading-snug">{s.value}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">
            Lihat detail
            <Icon name="lucide:chevron-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-0 pointer-events-none" style="transform: translateY(1px)">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="w-full h-10 md:h-14">
      <path d="M0,28 C240,56 480,0 720,28 C960,56 1200,0 1440,28 L1440,60 L0,60 Z" fill="#0A3B1D"/>
    </svg>
  </div>
</section>
