---
import { Icon } from "astro-icon/components";
import { CONTACT, FOOTER } from "../data/config";

const socials = [
  { href: `mailto:${CONTACT.email}`, label: CONTACT.email, icon: "lucide:mail" },
  { href: CONTACT.instagramUrl, label: CONTACT.instagram, icon: "simple-icons:instagram" },
  { href: CONTACT.tiktokUrl, label: CONTACT.tiktok, icon: "simple-icons:tiktok" },
  { href: CONTACT.facebookUrl, label: CONTACT.facebook, icon: "simple-icons:facebook" },
  { href: CONTACT.twitterUrl, label: CONTACT.twitter, icon: "simple-icons:x" },
];
---

<div class="bg-surface">
  <div class="max-w-6xl mx-auto px-4">
    <hr class="border-border" />
  </div>
</div>
<footer class="bg-[#08331A] text-white py-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 mb-8">
      {socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith("mailto") ? undefined : "_blank"}
          rel="noopener"
          class="flex items-center gap-2 text-sm text-muted hover:text-accent hover:bg-white/5 px-3 py-1.5 rounded-lg transition-all"
        >
          <Icon name={s.icon} class="w-4 h-4 shrink-0" />
          {s.label}
        </a>
      ))}
    </div>
    <hr class="border-border mb-6" />
    <p class="text-sm text-muted text-center">{FOOTER.copyright}</p>
  </div>
</footer>
